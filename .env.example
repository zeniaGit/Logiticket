# Local Docker Compose defaults. In Coolify, define these in the resource's Environment Variables.
NODE_ENV=development
PORT=3001
UPLOAD_DIR=./uploads
TRUST_PROXY=0
SESSION_SECRET=replace-with-a-long-random-secret
POSTGRES_DB=logiticket
POSTGRES_USER=logiticket
POSTGRES_PASSWORD=replace-with-a-long-random-password
# For running Node directly on the host. Compose overrides this to reach its internal db service.
DATABASE_URL=postgres://logiticket:replace-with-a-long-random-password@localhost:5432/logiticket
